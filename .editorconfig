# EditorConfig —— 统一编辑器行为，别让 IDE"好心"改坏脚本
# https://editorconfig.org
root = true

[*]
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# ------------------------------------------------------------
#  PowerShell / C#：必须 UTF-8 带 BOM
#  （PS 5.1 按 GBK 读无 BOM 的 .ps1 → 中文注释语法错误；csc 同理）
# ------------------------------------------------------------
[*.{ps1,psm1,cs}]
charset = utf-8-bom

# ------------------------------------------------------------
#  VBS：必须纯 ASCII（wscript 按 ANSI 读；中文注释的最后一个字节会吞掉换行）
#  EditorConfig 没有 ascii 这个取值，这里只能靠肉眼 + tools\Test-Encoding.ps1 把关：
#  这个文件里除了英文注释以外不允许出现任何非 ASCII 字符。
# ------------------------------------------------------------
[*.vbs]
charset = latin1
trim_trailing_whitespace = false

[*.manifest]
charset = utf-8-bom

# ------------------------------------------------------------
#  文档与配置：LF、不带 BOM
# ------------------------------------------------------------
[*.{md,yml,yaml,json}]
charset = utf-8
end_of_line = lf
indent_size = 2
trim_trailing_whitespace = false

[{LICENSE,.gitignore,.gitattributes,.editorconfig}]
charset = utf-8
end_of_line = lf
